# ---- Supabase (free tier) ----
# Project URL from Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe for browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key. SERVER ONLY. Never expose to the browser.
# Used to write room_access rows after verified payment/admin action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Jitsi (self-hosted on Oracle Cloud Always Free) ----
# Public URL of your Jitsi deployment, e.g. https://meet.example.com
NEXT_PUBLIC_JITSI_DOMAIN=meet.example.com
# Shared secret configured in /etc/jitsi/jitsi-meet-tokens (or prosody config).
# Used by our server to sign participant JWTs. SERVER ONLY.
JITSI_JWT_SECRET=your-jitsi-jwt-secret
# Issuer + audience must match the Prosody token verification config.
JITSI_JWT_ISSUER=bytes2bytchs
JITSI_JWT_AUDIENCE=jitsi
# App ID configured in Prosody (token_app_id)
JITSI_JWT_APP_ID=bytes2bytchs
# Token lifetime in seconds. Short so revocation takes effect quickly.
JITSI_JWT_TTL_SECONDS=300

# ---- PayPal ----
# Client ID / secret from the PayPal developer dashboard.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# 'sandbox' or 'live'
PAYPAL_ENV=sandbox
# Webhook ID used to verify webhook signatures server-side.
PAYPAL_WEBHOOK_ID=your-webhook-id

# ---- App ----
# Base URL used to build redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of admin emails allowed into the admin console.
ADMIN_EMAILS=you@example.com
